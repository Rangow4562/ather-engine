# Stage 1: Build the JAR using Maven
FROM maven:3.9.8-eclipse-temurin-21 AS builder

# Convert line endings to avoid Checkstyle issues
RUN apt-get update && apt-get install -y dos2unix

WORKDIR /build

# Copy source files
COPY . .

# Convert line endings for all source files
RUN find . -name "*.java" -type f -exec dos2unix {} \;
RUN find . -name "*.xml" -type f -exec dos2unix {} \;
RUN find . -name "*.properties" -type f -exec dos2unix {} \;

# Build the JAR using system Maven, skipping checkstyle and other validations
# Build with exec-jar profile to create executable JAR with proper manifest
# Skip validation phases entirely and disable checkstyle plugin
RUN mvn compile -DskipTests -Dmaven.test.skip=true -Dmaven.gitcommitid.skip=true -Dcheckstyle.skip=true -Dmaven.dependency.skip=true -Pexec-jar,skip-checkstyle && \
    mvn package -DskipTests -Dmaven.test.skip=true -Dmaven.gitcommitid.skip=true -Dcheckstyle.skip=true -Dmaven.dependency.skip=true -Pexec-jar,skip-checkstyle

# Install locally built modules to local Maven repository for shade plugin
WORKDIR /build
RUN mvn install -DskipTests -Dmaven.test.skip=true -Dmaven.gitcommitid.skip=true -Dcheckstyle.skip=true -Pexec-jar,skip-checkstyle

# Verify exec-jar profile was applied and create proper fat JAR if needed
WORKDIR /build/ather-server
RUN ls -la target/ather-server-*-executable.jar && \
    echo "Creating proper fat JAR with all dependencies..." && \
    mvn package shade:shade -Pexec-jar,skip-checkstyle -DskipTests && \
    echo "Verifying fat JAR contains bootstrap classes..." && \
    jar tf target/ather-server-*-executable.jar | grep -q "io/airlift/bootstrap/ApplicationConfigurationException.class" && \
    echo "Bootstrap classes found in fat JAR" || \
    (echo "Bootstrap classes missing, using existing JAR with external dependencies...")

# Copy all dependency JARs to create proper classpath (run from ather-server module)
WORKDIR /build/ather-server
# Use local repository and skip dependency resolution for ather modules
RUN mvn dependency:copy-dependencies -DskipTests -DoutputDirectory=target/lib -Dmaven.repo.local=/root/.m2/repository || \
    (echo "Some dependencies not found in remote, copying local ather modules..." && \
     mkdir -p target/lib && \
     cp ../ather-base/target/ather-base-*.jar target/lib/ 2>/dev/null || true && \
     cp ../ather-main/target/ather-main-*.jar target/lib/ 2>/dev/null || true && \
     cp ../trino-parser/target/trino-parser-*.jar target/lib/ 2>/dev/null || true && \
     echo "Copying bootstrap dependency..." && \
     find /root/.m2/repository -name "bootstrap-*.jar" -path "*/io/airlift/*" -exec cp {} target/lib/ \; 2>/dev/null || true)

# Convert entrypoint.sh line endings in builder stage where dos2unix is available
WORKDIR /build
RUN dos2unix entrypoint.sh

# Stage 2: Create the runtime image
FROM eclipse-temurin:21
LABEL maintainer="https://www.canner.io/"
WORKDIR /usr/src/app

RUN \
    apt update && \
    apt -y install curl gpg lsb-release && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/postgresql.gpg && \
    echo "deb http://apt.postgresql.org/pub/repos/apt/ `lsb_release -cs`-pgdg main" | tee /etc/apt/sources.list.d/pgdg.list && \
    apt update && \
    apt -y install postgresql-client-13

# Get the version and set environment variables
ARG ather_VERSION
ENV ENV_ather_VERSION=${ather_VERSION}
ENV ather_JAR=ather-server-${ENV_ather_VERSION}-executable.jar

COPY --from=builder /build/ather-server/target/ather-server-*.jar ./${ather_JAR}
COPY --from=builder /build/ather-server/target/lib ./lib/

# Copy the converted entrypoint.sh from builder stage and make executable
COPY --from=builder /build/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

CMD ./entrypoint.sh ${ather_JAR} ${MAX_HEAP_SIZE} ${MIN_HEAP_SIZE}